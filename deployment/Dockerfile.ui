FROM node:22-alpine AS build
WORKDIR /app
COPY src/ClarityClinical.Ui/package*.json ./
RUN npm ci
COPY src/ClarityClinical.Ui/ ./
RUN npm run build

FROM nginx:1.27-alpine AS final
COPY deployment/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/clarity-clinical.ui/browser /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O - http://127.0.0.1/health/live >/dev/null 2>&1 || exit 1
